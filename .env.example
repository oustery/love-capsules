# Supabase — создай проект на supabase.com и скопируй значения из Project Settings → API
PUBLIC_SUPABASE_URL=https://ТВОЙ-ПРОЕКТ.supabase.co
PUBLIC_SUPABASE_ANON_KEY=ТВОЙ-ANON-КЛЮЧ

# Технический email общего аккаунта (придумай любой валидный адрес, он нигде не «живёт»)
PUBLIC_AUTH_EMAIL=love@capsule.app

# Только для локального скрипта создания пользователя (не попадает в сборку):
# SUPABASE_URL=https://ТВОЙ-ПРОЕКТ.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=ТВОЙ-SERVICE-ROLE-КЛЮЧ
