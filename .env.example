# Supabase — Project Settings → API
# ⚠️ Не хватает только адреса: подставь Project URL вида https://xxxx.supabase.co
PUBLIC_SUPABASE_URL=https://ТВОЙ-ПРОЕКТ.supabase.co

# Publishable-ключ (новый формат вместо anon): открытый, попадает в клиентский бандл — так и задумано
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_HYLlPzLl4y_f4XzZRR2tXQ_yTC9OOqo

# Технический email общего аккаунта (придумай любой валидный адрес, он нигде не «живёт»)
PUBLIC_AUTH_EMAIL=love@capsule.app

# Только для локального скрипта создания пользователя (не попадает в сборку и НЕ коммитится —
# файл .env в .gitignore):
# SUPABASE_URL=https://ТВОЙ-ПРОЕКТ.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<твой sb_secret_... — серверный ключ, приложению он не нужен>
